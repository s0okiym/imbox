{
  "name": "@imbox/resources",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup:dev": "tsx src/setup-cli.ts"
  },
  "dependencies": {
    "@imbox/application": "workspace:*",
    "@imbox/auth": "workspace:*",
    "@imbox/db": "workspace:*",
    "@imbox/contracts": "workspace:*",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:"
  }
}
