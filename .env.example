# Local development credentials only. Never use these values for production.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=4100
DATABASE_URL=postgres://imbox_app:imbox_local_app@127.0.0.1:55432/imbox_dev
IDENTITY_DATABASE_URL=postgres://imbox_identity:imbox_local_identity@127.0.0.1:55432/imbox_dev
MIGRATION_DATABASE_URL=postgres://imbox_owner:imbox_local_owner@127.0.0.1:55432/imbox_dev
TEST_DATABASE_URL=postgres://imbox_owner:imbox_local_owner@127.0.0.1:55432/imbox_test
TEST_APP_DATABASE_URL=postgres://imbox_app:imbox_local_app@127.0.0.1:55432/imbox_test
# Generate a unique value before enabling sessions.
SESSION_SECRET=replace-with-a-random-value-at-least-32-bytes
TEST_IDENTITY_DATABASE_URL=postgres://imbox_identity:imbox_local_identity@127.0.0.1:55432/imbox_test
ENABLE_DEV_AUTH=false
DEV_AUTH_PRINCIPAL_IDS=30000000-0000-4000-8000-000000000001,30000000-0000-4000-8000-000000000002,30000000-0000-4000-8000-000000000003
# Optional OIDC. Production requires HTTPS and a separately configured client.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOW_LOCAL_HTTP=false
WORKER_TENANT_IDS=10000000-0000-4000-8000-000000000001
WORKER_POLL_INTERVAL_MS=250
# Optional, separately enabled local model worker. No external API key is needed.
ENABLE_LOCAL_MODEL=false
OLLAMA_ORIGIN=http://127.0.0.1:11435
OLLAMA_ALLOW_LOOPBACK_HTTP=true
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_MODEL_DIGEST=sha256:7df6b6e09427a769808717c0a93cadc4ae99ed4eb8bf5ca557c90846becea435
# Optional controlled sandbox connector. The journal must be retained independently of PostgreSQL.
ENABLE_DEMO_TOOL=false
ACTION_JOURNAL_DIRECTORY=
ACTION_JOURNAL_SIGNING_KEY=replace-with-a-separate-random-value-at-least-32-bytes
DEMO_TOOL_EXECUTE_URL=
DEMO_TOOL_LOOKUP_URL=
DEMO_TOOL_ALLOW_LOOPBACK=false
DEMO_TOOL_AUTHORIZATION=
TOOL_RUNNER_TENANT_IDS=10000000-0000-4000-8000-000000000001

# Optional private text/Markdown/JSON resources (fixed 8 MiB limit).
ENABLE_RESOURCES=false
S3_ENDPOINT=http://127.0.0.1:18333
S3_REGION=us-east-1
S3_BUCKET=imbox-resources-dev
S3_ACCESS_KEY_ID=imbox_local_s3_app
S3_SECRET_ACCESS_KEY=imbox_local_s3_app_secret
MAX_UPLOAD_BYTES=8388608

# Required outside development/test. Mount separately from PostgreSQL backups; retain >= 90 days.
POLICY_LEDGER_DIRECTORY=/var/lib/imbox/policy-ledger
POLICY_LEDGER_SIGNING_KEY=replace-with-at-least-32-random-characters

# Explicit deployment retention policy (1..36500 days); visible in /v1/governance/policy.
RETENTION_MESSAGE_DAYS=365
RETENTION_RESOURCE_DAYS=365
RETENTION_RUN_CONTENT_DAYS=7

# Offline caches require both deployment permission and explicit device opt-in.
OFFLINE_MESSAGE_CACHE_ALLOWED=false
OFFLINE_QUEUE_ALLOWED=true

# Optional Web Push: all four values required together. Generate keys once and keep secrets outside Git.
# PUSH_ENCRYPTION_KEY=<32 random bytes encoded base64url>
# PUSH_VAPID_PUBLIC_KEY=<P-256 public key base64url>
# PUSH_VAPID_PRIVATE_KEY=<P-256 private key base64url>
# PUSH_VAPID_SUBJECT=mailto:operations@example.com
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
