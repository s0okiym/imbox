# Docker Compose interpolation variables; use absolute host paths.
IMBOX_API_IMAGE=imbox/api:local
IMBOX_WORKER_IMAGE=imbox/worker:local
IMBOX_WEB_IMAGE=imbox/web:local
IMBOX_PUBLIC_HOST=im.example.com
IMBOX_API_ENV_FILE=/etc/imbox/api.env
IMBOX_WORKER_ENV_FILE=/etc/imbox/worker.env
IMBOX_MIGRATION_ENV_FILE=/etc/imbox/migration.env
IMBOX_POLICY_DIR=/var/lib/imbox/policy-ledger
# Optional compose.tools.yaml requires these in addition:
# IMBOX_TOOL_IMAGE=imbox/tool-runner:local
# IMBOX_TOOL_ENV_FILE=/etc/imbox/tool.env
# IMBOX_ACTION_DIR=/var/lib/imbox/action-journal
