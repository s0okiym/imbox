# Copy outside the repository; chmod 600. Raw env format: do not quote values.
DATABASE_URL=postgres://imbox_app:REPLACE@db.example.com:5432/imbox?sslmode=verify-full
IDENTITY_DATABASE_URL=postgres://imbox_identity:REPLACE@db.example.com:5432/imbox?sslmode=verify-full
PUBLIC_ORIGIN=https://im.example.com
SESSION_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET
POLICY_LEDGER_SIGNING_KEY=REPLACE_WITH_SEPARATE_RANDOM_SECRET
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=REPLACE
OIDC_CLIENT_SECRET=REPLACE
ENABLE_RESOURCES=false
ENABLE_LOCAL_MODEL=false
ENABLE_DEMO_TOOL=false
OFFLINE_MESSAGE_CACHE_ALLOWED=false
OFFLINE_QUEUE_ALLOWED=true
