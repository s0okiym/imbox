# Use the same policy ledger key as API. Supply real tenant UUIDs explicitly.
DATABASE_URL=postgres://imbox_app:REPLACE@db.example.com:5432/imbox?sslmode=verify-full
SESSION_SECRET=REPLACE_WITH_SAME_API_SESSION_SECRET
POLICY_LEDGER_SIGNING_KEY=REPLACE_WITH_SAME_API_POLICY_SECRET
WORKER_TENANT_IDS=REPLACE_WITH_TENANT_UUID
WORKER_POLL_INTERVAL_MS=250
WORKER_LEASE_SECONDS=30
ENABLE_LOCAL_MODEL=false
ENABLE_RESOURCES=false
ENABLE_DEMO_TOOL=false
